rules_version = '2';

// usage_daily / usage_presence: 匿名統計用（メモ本文は保存しない）
// Firebase Console → 認証 → 匿名 を有効化すること

service cloud.firestore {
  match /databases/{database}/documents {
    function isUsageDay(dayId) {
      return dayId.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    match /usage_daily/{dayId} {
      allow read: if false;
      allow create: if request.auth != null
        && isUsageDay(dayId)
        && request.resource.data.keys().hasOnly(['sessions', 'updatedAt'])
        && request.resource.data.sessions == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && isUsageDay(dayId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessions', 'updatedAt'])
        && request.resource.data.sessions == resource.data.sessions + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /usage_presence/{uid} {
      allow read: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastDay', 'platform', 'updatedAt'])
        && isUsageDay(request.resource.data.lastDay)
        && request.resource.data.platform in ['web', 'pwa']
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastDay', 'platform', 'updatedAt'])
        && isUsageDay(request.resource.data.lastDay)
        && request.resource.data.platform in ['web', 'pwa']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /notes/{noteId} {
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
